# Trợ lý ảo SenseCAP Watcher - khóa API (file này KHÔNG được commit)

# Gemini (LLM) - lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (nhận dạng giọng nói Whisper) - lấy tại https://console.groq.com/keys
GROQ_API_KEY=

# Model Gemini. Rẻ nhất: gemini-2.5-flash-lite ($0.10/$0.40 mỗi 1M token)
# Mặc định: gemini-3.1-flash-lite ($0.25/$1.50), tiếng Việt tốt hơn
GEMINI_MODEL=gemini-3.1-flash-lite

# Vị trí nhà (cho thời tiết)
HOME_CITY=Hà Nội
HOME_LAT=21.0285
HOME_LON=105.8542
