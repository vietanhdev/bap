root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cc,h,c,cpp,hpp}]
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 4

[*.{json,yml,yaml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated fonts and binary assets
[*.{bin,gif,png,jpg}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
