+void Application::PlayStream(const std::string& url, const std::string& title,
+                             std::vector<NotifySubtitle> lyrics) {
+    struct Job {
+        Application* app;
+        std::string url, title;
+        std::vector<NotifySubtitle> lyrics;
+    };
+    auto* job = new Job{this, url, title, std::move(lyrics)};
+    Schedule([this]() {
+        if (GetDeviceState() == kDeviceStateNotifying) StopNotification();
+        if (protocol_ && protocol_->IsAudioChannelOpened()) protocol_->CloseAudioChannel();
+    });
+    // Stopping the previous stream and closing the conversation are asynchronous: wait until the
+    // device is idle and the player is free (up to 6 s), then start on the main task.
+    xTaskCreate(
+        [](void* arg) {
+            auto* job = static_cast<Job*>(arg);
+            auto* app = job->app;
+            for (int i = 0; i < 60; ++i) {
+                if (app->GetDeviceState() == kDeviceStateIdle && !app->notify_player_.IsBusy()) break;
+                vTaskDelay(pdMS_TO_TICKS(100));
+            }
+            app->Schedule([job]() {
+                auto lyrics = std::move(job->lyrics);
+                lyrics.insert(lyrics.begin(), {.start_ms = 0, .text = job->title});
+                job->app->StartNotification(job->url, std::move(lyrics));
+                Board::GetInstance().GetDisplay()->SetEmotion("relaxed");  // eyes closed, enjoying the music (cheap to draw)
+                delete job;
+            });
+            vTaskDelete(nullptr);
+        },
+        "play_stream", 3072, job, 2, nullptr);
+}
+#endif
